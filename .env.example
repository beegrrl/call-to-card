# Required: your Claude API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: send each objection to PostHog as an event
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Optional: Granola API key (Business and Enterprise workspaces only)
GRANOLA_API_KEY=

# Optional: which Claude model to use
CALL_TO_CARD_MODEL=claude-sonnet-5-5
